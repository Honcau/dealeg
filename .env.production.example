# ─── PRODUCTION ENV cho Contabo VPS ─────────────────────────────────────────────
# Copy thành .env.production và điền giá trị thật
# LƯU Ý: DB cài trực tiếp trên VPS → dùng host.docker.internal

# ── Database (PostgreSQL trên host VPS) ─────────────────────────────────────────
# host.docker.internal = IP của VPS host, nhìn từ trong container
DATABASE_URL="postgresql://dealeg:MAT_KHAU@host.docker.internal:5432/dealeg"

# ── NextAuth ────────────────────────────────────────────────────────────────────
# NextAuth v5 dùng AUTH_* (tên mới). Giữ cả NEXTAUTH_* cho tương thích.
AUTH_SECRET="tao-bang-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="https://dealeg.com"
NEXTAUTH_SECRET="tao-bang-openssl-rand-base64-32"

# ── OAuth providers ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Admin panel ─────────────────────────────────────────────────────────────────
ADMIN_SECRET="mat-khau-admin"

# ── DeepL translation ───────────────────────────────────────────────────────────
DEEPL_API_KEY=""

# ── Redis (trong Docker network) ────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ── Affiliate IDs ───────────────────────────────────────────────────────────────
NAMECHEAP_AFFILIATE_ID=""
HOSTINGER_AFFILIATE_ID=""
NORDVPN_AFFILIATE_ID=""
WIX_AFFILIATE_ID=""
FRAMER_AFFILIATE_ID=""

# ─── Online Tools Affiliate (mảng mới - nhu cầu VN cao) ───────────────────────
PDFELEMENT_AFFILIATE_ID=""
PDFREADERPRO_AFFILIATE_ID=""
CANVA_AFFILIATE_ID=""
SMALLPDF_AFFILIATE_ID=""

# ─── Google Analytics ─────────────────────────────────────────────────────────
# Lấy Measurement ID tại analytics.google.com (dạng G-XXXXXXXXXX)
# Phải có tiền tố NEXT_PUBLIC_ để client-side đọc được
NEXT_PUBLIC_GA_ID=""

# ─── Listmonk (email list manager — Phase 0) ─────────────────────────────────
# Xem LISTMONK_SETUP.md. Deploy Listmonk qua docker-compose, tạo lists double
# opt-in mỗi ngôn ngữ, tạo API user → điền dưới đây.
LISTMONK_URL="https://mail.dealeg.com"
LISTMONK_API_USER=""
LISTMONK_API_TOKEN=""
LISTMONK_LIST_MAP='{"vi":1,"en":2,"de":3}'
LISTMONK_DEFAULT_LIST_ID="2"
